name: Mobile Frontend CI

on:
  push:
    branches: ["**"]
    paths:
      - "src/mobile/**"
      - ".github/workflows/mobile-ci.yml"
  pull_request:
    branches: ["dev","main"]
    paths:
      - "src/mobile/**"

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    
    strategy:
      matrix:
        node-version: ["20.x"]

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node-version }}
          cache: "npm"
          cache-dependency-path: "src/mobile/package-lock.json"

      - name: Install dependencies
        working-directory: src/mobile
        run: npm ci

      - name: Lint code
        working-directory: src/mobile
        run: npm run lint

      - name: Run unit tests
        working-directory: src/mobile
        run: npm run test:run  || echo 'Unit tests not configured yet'

      - name: Run integration tests
        working-directory: src/mobile
        run: npm run test:run -- tests/integration || echo 'Integration tests not configured yet'

      
